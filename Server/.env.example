# ==========================================
# CẤU HÌNH HỆ THỐNG SMART AGRICULTURE
# ==========================================

# 1. Cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgresql://postgres:Nam123456@localhost:5432/greenhouse_db

# 2. Khóa bảo mật API (Dùng xác thực ESP32 và Web/App)
API_KEY=smart_farm_secret_key_2026

# 3. Tối ưu ghi Database (giây): Chỉ ghi lịch sử vào DB sau mỗi N giây hoặc khi đổi trạng thái rơ-le
DB_LOG_INTERVAL_SECONDS=60

# 4. Cấu hình cảnh báo Telegram Bot (Tùy chọn)
# Tạo bot qua @BotFather trên Telegram để lấy Token và Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_ENABLED=false

# 5. Cấu hình OpenWeatherMap (Tùy chọn - Dự báo thời tiết tránh tưới khi sắp mưa)
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Hanoi,VN

